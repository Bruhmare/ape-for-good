    "verify": "node tools/verify.mjs"
  },
  "dependencies": {
    "@pump-fun/pump-sdk": "^2.0.0",
    "@solana/spl-token": "^0.4.15",
    "@solana/web3.js": "^1.99.0",
    "bn.js": "^5.2.5",
    "bs58": "^6.0.0",
    "sharp": "^0.34.4"
  }
}
