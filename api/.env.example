# Copy to api/.env for local runs. Nothing here is required to start; defaults are in src/config.js.
PORT=4270
DATA_DIR=./data
PUBLIC_ORIGIN=http://127.0.0.1:3270
EXTRA_ORIGINS=http://127.0.0.1:4270,http://localhost:4270

# Solana mainnet RPC (the public endpoint works for low traffic)
RPC_URL=https://api.mainnet-beta.solana.com

# Secrets. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# CLAIM_SECRET signs verification claims. ESCROW_SEED derives every fundraiser's escrow wallet:
# back it up and never change it once a coin exists. When unset, both are generated into DATA_DIR/state.json.
CLAIM_SECRET=
ESCROW_SEED=

# Password for /admin (read-only overview). Admin is off when unset.
ADMIN_KEY=

# Crawler and catalog
IMPORT_SITEMAPS=0      # 1 = on boot, pull every fundraiser from GoFundMe's sitemaps when the catalog is empty
ENRICH=1               # background reader: one never-read fundraiser every ENRICH_GAP_MS
ENRICH_GAP_MS=4000
GFM_MIN_GAP_MS=3000    # floor between any two reads of gofundme.com
OPEN_LAUNCHES_PER_HOUR=3
CREATOR_FEE_BPS=300    # clamped to what pump.fun allows at launch time
